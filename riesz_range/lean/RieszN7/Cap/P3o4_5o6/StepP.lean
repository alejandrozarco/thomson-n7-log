/-- **Cap piece `[3/4, 5/6]` modulo Step M** (Step P closed): for `s ∈ [a, b]`, pins `V` within `ε` of the
quintic models with the e-row components equal to their `phiS s` values, the three minorants with exact contacts at
`w = wts (λ(s), V, va, vb)` give `CapSpecSharp (phiS s) (−99/100)`. -/
theorem capSharp_stepP (s : ℝ) (hs : s ∈ Set.Icc RieszN7.CapLit.StepP.P3o4_5o6.a RieszN7.CapLit.StepP.P3o4_5o6.b) (V : Fin 7 → ℝ)
    (hV : ∀ k, |V k - pv (RieszN7.CapLit.StepP.P3o4_5o6.p k) RieszN7.CapLit.StepP.P3o4_5o6.sm s| ≤ RieszN7.CapLit.StepP.P3o4_5o6.ε k)
    (hv : V 0 = RieszN7.phiS s 0 ∧ V 2 = RieszN7.phiS s (-1) ∧
      V 3 = (RieszN7.phiS s c1 + RieszN7.phiS s c2) / 2)
    (hHA : ∀ t, -1 ≤ t → t ≤ -99 / 100 → HAfam objs (wts (lam RieszN7.CapLit.StepP.P3o4_5o6.a RieszN7.CapLit.StepP.P3o4_5o6.b s) V RieszN7.CapLit.StepP.P3o4_5o6.va RieszN7.CapLit.StepP.P3o4_5o6.vb) t ≤ RieszN7.phiS s t ∧
      (HAfam objs (wts (lam RieszN7.CapLit.StepP.P3o4_5o6.a RieszN7.CapLit.StepP.P3o4_5o6.b s) V RieszN7.CapLit.StepP.P3o4_5o6.va RieszN7.CapLit.StepP.P3o4_5o6.vb) t = RieszN7.phiS s t → t = -1))
    (hHB : ∀ t, -1 ≤ t → t < 1 → HBfam objs (wts (lam RieszN7.CapLit.StepP.P3o4_5o6.a RieszN7.CapLit.StepP.P3o4_5o6.b s) V RieszN7.CapLit.StepP.P3o4_5o6.va RieszN7.CapLit.StepP.P3o4_5o6.vb) t ≤ RieszN7.phiS s t ∧
      (HBfam objs (wts (lam RieszN7.CapLit.StepP.P3o4_5o6.a RieszN7.CapLit.StepP.P3o4_5o6.b s) V RieszN7.CapLit.StepP.P3o4_5o6.va RieszN7.CapLit.StepP.P3o4_5o6.vb) t = RieszN7.phiS s t → t = 0))
    (hHC : ∀ t, -1 ≤ t → t < 1 → HCfam objs (wts (lam RieszN7.CapLit.StepP.P3o4_5o6.a RieszN7.CapLit.StepP.P3o4_5o6.b s) V RieszN7.CapLit.StepP.P3o4_5o6.va RieszN7.CapLit.StepP.P3o4_5o6.vb) t ≤ RieszN7.phiS s t ∧
      (HCfam objs (wts (lam RieszN7.CapLit.StepP.P3o4_5o6.a RieszN7.CapLit.StepP.P3o4_5o6.b s) V RieszN7.CapLit.StepP.P3o4_5o6.va RieszN7.CapLit.StepP.P3o4_5o6.vb) t = RieszN7.phiS s t → t = c1 ∨ t = c2)) :
    CapSpecSharp (RieszN7.phiS s) (-99 / 100) := by
  obtain ⟨hPF, hRF, hPA, hPB, hPG⟩ := stepP s hs V hV
  exact capSharp_piece s _ V _ _ hv pins_a pins_b hPF hRF hPA hPB hPG hHA hHB hHC

end RieszN7.Cap.P3o4_5o6
