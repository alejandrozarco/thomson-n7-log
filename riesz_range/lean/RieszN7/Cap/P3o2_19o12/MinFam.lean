    (f' := fun t => s * phiS (s + 2) t - famP objsM (wP s) (fun c => pder c.HC) t)
    (f'' := fun t => s * ((s + 2) * phiS (s + 2 + 2) t) - famP objsM (wP s) (fun c => pder (pder c.HC)) t)
    hαc hcβ
    (fun x hx => (hasDerivAt_phiS s (lt1 hx hβ)).sub (hasDerivAt_famP objsM (wP s) TCertR.HC x))
    (fun x hx => (hasDerivAt_phiS1 s (lt1 hx hβ)).sub (hasDerivAt_famP objsM (wP s) (fun c => pder c.HC) x))
    (fun x hx => win_lt2 _ _ s x (lt1 hx hβ)
      (boundC2 s hs0 hs1 x (abs1 (by linarith [hx.1]) (by linarith [hx.2]))) (hbox x hx.1 hx.2))
    (sub_eq_zero.mpr h0.symm) (sub_eq_zero.mpr h1.symm) t ht
  obtain ⟨W1, W2⟩ := W
  have W1' : 0 ≤ phiS s t - famP objsM (wP s) TCertR.HC t := W1
  exact ⟨by linarith, fun e => W2 (sub_eq_zero.mpr e.symm)⟩

