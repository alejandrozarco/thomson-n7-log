/-- On a `B`/`C` window: `famP^(2) < Fq/DH ≤ s (s+2) φ_{s+4}`. -/
theorem win_lt2 (sel : TCertR → List ℤ) (Fq : List (List ℤ)) (s t : ℝ) (ht : t < 1)
    (hb : famP objsM (wP s) sel t < peval2 Fq s t / DH)
    (hbox : peval2 (mul2 (uq 2) Fq) s t / ((DH : ℕ) : ℝ) ≤ peval [0, 2, 1] s * phiS s t) :
    0 < s * ((s + 2) * phiS (s + 2 + 2) t) - famP objsM (wP s) sel t := by
  rw [peval2_mul2_uq, peval_P2] at hbox
  have hu : (0 : ℝ) < 2 - 2 * t := by linarith
  have hu2 : (0 : ℝ) < (2 - 2 * t) ^ 2 := by positivity
  have h2 : peval2 Fq s t / DH ≤ s * (s + 2) * phiS s t / (2 - 2 * t) ^ 2 := by
    rw [le_div_iff₀ hu2]
    calc peval2 Fq s t / DH * (2 - 2 * t) ^ 2 = (2 - 2 * t) ^ 2 * peval2 Fq s t / DH := by ring
      _ ≤ _ := hbox
  have e : s * ((s + 2) * phiS (s + 2 + 2) t) = s * (s + 2) * phiS s t / (2 - 2 * t) ^ 2 := by
    rw [phiS_add_four s ht]; ring
  rw [e]; linarith

