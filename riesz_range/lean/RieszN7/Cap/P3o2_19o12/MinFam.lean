/-- A `C` window `[α, β] ∋ c`. -/
theorem winC (s : ℝ) (hs0 : ((3 : ℝ) / 2) ≤ s) (hs1 : s ≤ ((19 : ℝ) / 12)) (α β c : ℝ) (hαc : α ≤ c) (hcβ : c ≤ β) (hα : -1 ≤ α)
    (hβ : β < 1)
    (hbox : ∀ x, α ≤ x → x ≤ β → peval2 hqC2 s x / ((DH : ℕ) : ℝ) ≤ peval [0, 2, 1] s * phiS s x)
    (h0 : famP objsM (wP s) TCertR.HC c = phiS s c)
    (h1 : famP objsM (wP s) (fun c => pder c.HC) c = s * phiS (s + 2) c) :
    ∀ t ∈ Set.Icc α β, famP objsM (wP s) TCertR.HC t ≤ phiS s t ∧
      (famP objsM (wP s) TCertR.HC t = phiS s t → t = c) := by
  intro t ht
