  rw [r2c1_stat_H, r2c1_stat_F0, r2c1_stat_F1, r2c1_stat_F2, r2c1_stat_F3, r2c1_stat_S0, r2c1_stat_S1, r2c1_stat_S2, r2c1_stat_S3, r2c1_stat_S4, r2c1_stat_S5, r2c1_stat_S6, r2c1_stat_S7]
