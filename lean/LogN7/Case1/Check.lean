/-- The Kronecker check of the identity expression. -/
theorem r2c1_cf_chk : chk LogN7.Case1Data.cf.idE = true := by
  have h := ThomsonN7.Case1.c1Stat_eq 108 11 LogN7.Case1Data.cf.idE
