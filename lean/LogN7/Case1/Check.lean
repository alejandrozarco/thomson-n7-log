/-- The statistics of the whole identity expression: `ℓ¹`-norm below `2 ^ 108`, degrees `10, 10, 10`, Kronecker value `0`. -/
theorem r2c1_idE_stat : ThomsonN7.Case1.c1Stat 108 11 LogN7.Case1Data.cf.idE = (262795887331169832012391330865616, 10, 10, 10, (0 : Int)) := by
