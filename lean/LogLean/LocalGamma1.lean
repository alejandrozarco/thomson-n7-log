/-! ## The certificate matrices and their check -/

/-- operator-norm bound `c` for `A_α` on W. -/
def cc : ℚ := 261/200
/-- penalty weight `λ` on `KKᵀ`. -/
def lam : ℚ := 100
/-- `3γ₁`: rational with `G1x3² ≥ 4c²/5`. -/
def G1x3 : ℚ := 233445497/200000000

def Ad (al i j : ℕ) : Kel :=
  if al = 0 then (A1dat.getD i []).getD j Kel.zero else (A2dat.getD i []).getD j Kel.zero
def Kd (i b : ℕ) : Kel := (Kdat.getD i []).getD b Kel.zero
def Dd (c q : ℕ) : ℚ := (Ddat.getD c []).getD q 0
def Ld (c q i : ℕ) : ℚ := ((Ldat.getD c []).getD q []).getD i 0
def sgnQ (s : ℕ) : ℚ := if s = 0 then 1 else -1

/-- Penalty `(KKᵀ)ᵢⱼ`. -/
def pen (i j : ℕ) : Kel :=
  ((((Kd i 0).mul (Kd j 0)).add ((Kd i 1).mul (Kd j 1))).add
    (((Kd i 2).mul (Kd j 2)).add ((Kd i 3).mul (Kd j 3)))).add ((Kd i 4).mul (Kd j 4))

/-- Certificate matrix `c`: `cc·I − sgn·A_α + λ·KKᵀ`. -/
def Mk (c i j : ℕ) : Kel :=
  ((Kel.ofQ (if i = j then cc else 0)).sub ((Ad (c / 2) i j).smul (sgnQ (c % 2)))).add ((pen i j).smul lam)

def ldl (c i j : ℕ) : ℚ := ((List.range 14).map fun q => Dd c q * Ld c q i * Ld c q j).sum

/-- Remainder `E = M − Lᵀ D L`, entrywise in K. -/
def Ek (c i j : ℕ) : Kel := (Mk c i j).sub (Kel.ofQ (ldl c i j))

/-- The computable check: pivots ≥ 0, `E` symmetric, `E` diagonally dominant on the α-box. -/
def certOK (c : ℕ) : Bool :=
  (List.range 14).all fun i =>
    decide (0 ≤ Dd c i) &&
    (List.range 14).all (fun j => decide (Ek c i j = Ek c j i)) &&
    decide (((List.range 14).map fun j => if i = j then (0 : ℚ) else (Ek c i j).aub aLo aHi).sum
      ≤ (Ek c i i).lo aLo aHi)

set_option profiler true in
theorem cert0 : certOK 0 = true := by decide +kernel
set_option profiler true in
theorem cert1 : certOK 1 = true := by decide +kernel
set_option profiler true in
theorem cert2 : certOK 2 = true := by decide +kernel
set_option profiler true in
theorem cert3 : certOK 3 = true := by decide +kernel

theorem certOK_true (c : ℕ) (hc : c < 4) : certOK c = true := by
  match c, hc with
  | 0, _ => exact cert0
  | 1, _ => exact cert1
  | 2, _ => exact cert2
  | 3, _ => exact cert3
  | n + 4, h => exact absurd h (by omega)

lemma certOK_parts (c : ℕ) (hc : c < 4) :
    (∀ i ∈ range 14, 0 ≤ Dd c i) ∧ (∀ i ∈ range 14, ∀ j ∈ range 14, Ek c i j = Ek c j i) ∧
    (∀ i ∈ range 14, ∑ j ∈ range 14, (if i = j then (0 : ℚ) else (Ek c i j).aub aLo aHi)
      ≤ (Ek c i i).lo aLo aHi) := by
  have h := certOK_true c hc
  simp only [certOK, List.all_eq_true, List.mem_range, Bool.and_eq_true, decide_eq_true_eq] at h
  refine ⟨fun i hi => (h i (mem_range.1 hi)).1.1, fun i hi j hj => ?_, fun i hi => ?_⟩
  · exact (h i (mem_range.1 hi)).1.2 j (mem_range.1 hj)
  · have := (h i (mem_range.1 hi)).2
    rwa [list_sum_range_map] at this

/-! ## Soundness: `M_c(a) ⪰ 0` for every real `a` in the box -/

theorem M_psd (c : ℕ) (hc : c < 4) {a : ℝ} (hl : (aLo : ℝ) ≤ a) (hh : a ≤ aHi) (x : ℕ → ℝ) :
    0 ≤ ∑ i ∈ range 14, ∑ j ∈ range 14, x i * (Mk c i j).ev a * x j := by
  obtain ⟨hD, hS, hDD⟩ := certOK_parts c hc
  have hl0 : 0 ≤ (aLo : ℝ) := by norm_num [aLo]
  have hsplit : ∀ i j, (Mk c i j).ev a = (∑ q ∈ range 14, (Dd c q : ℝ) * Ld c q i * Ld c q j) + (Ek c i j).ev a := by
    intro i j
    have e : ((ldl c i j : ℚ) : ℝ) = ∑ q ∈ range 14, (Dd c q : ℝ) * Ld c q i * Ld c q j := by
      unfold ldl; rw [list_sum_range_map]; push_cast; rfl
    rw [Ek, Kel.ev_sub, Kel.ev_ofQ, e]; ring
  have hsum : ∑ i ∈ range 14, ∑ j ∈ range 14, x i * (Mk c i j).ev a * x j
      = ∑ q ∈ range 14, (Dd c q : ℝ) * (∑ i ∈ range 14, (Ld c q i : ℝ) * x i) ^ 2
        + ∑ i ∈ range 14, ∑ j ∈ range 14, x i * (Ek c i j).ev a * x j := by
    have hA : ∀ i j, x i * (Mk c i j).ev a * x j
        = ∑ q ∈ range 14, x i * ((Dd c q : ℝ) * Ld c q i * Ld c q j) * x j + x i * (Ek c i j).ev a * x j := by
      intro i j
      rw [hsplit, mul_add, add_mul, Finset.mul_sum, Finset.sum_mul]
    have e1 : ∀ q, (Dd c q : ℝ) * (∑ i ∈ range 14, (Ld c q i : ℝ) * x i) ^ 2
        = ∑ i ∈ range 14, ∑ j ∈ range 14, x i * ((Dd c q : ℝ) * Ld c q i * Ld c q j) * x j := by
      intro q
      have hr := qf_rank1 (fun i => (Ld c q i : ℝ)) x 14
      rw [← hr, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      ring
    have hB : ∑ i ∈ range 14, ∑ j ∈ range 14, ∑ q ∈ range 14,
          x i * ((Dd c q : ℝ) * Ld c q i * Ld c q j) * x j
        = ∑ q ∈ range 14, ∑ i ∈ range 14, ∑ j ∈ range 14,
          x i * ((Dd c q : ℝ) * Ld c q i * Ld c q j) * x j := by
      calc _ = ∑ i ∈ range 14, ∑ q ∈ range 14, ∑ j ∈ range 14,
              x i * ((Dd c q : ℝ) * Ld c q i * Ld c q j) * x j :=
            Finset.sum_congr rfl fun i _ => Finset.sum_comm
        _ = _ := Finset.sum_comm
    simp only [hA, Finset.sum_add_distrib, hB, e1]
  rw [hsum]
  refine add_nonneg (Finset.sum_nonneg fun q hq => mul_nonneg (by exact_mod_cast hD q hq) (sq_nonneg _)) ?_
  refine qform_dd_nonneg 14 (fun i j => (Ek c i j).ev a) x
    (fun i hi j hj => by simp only [hS i hi j hj]) (fun i hi => ?_)
  have hrow := hDD i hi
  have hrow' : (((∑ j ∈ range 14, (if i = j then (0 : ℚ) else (Ek c i j).aub aLo aHi)) : ℚ) : ℝ)
      ≤ (((Ek c i i).lo aLo aHi : ℚ) : ℝ) := by exact_mod_cast hrow
  push_cast at hrow'
  refine le_trans ?_ (hrow'.trans (Kel.lo_le_ev _ hl0 hl hh))
  refine Finset.sum_le_sum fun j _ => ?_
  split_ifs
  · simp
  · exact Kel.abs_ev_le _ hl0 hl hh

/-! ## Block structure -/

theorem block (c : ℕ) {a : ℝ} (ha : a ^ 4 = 20 * a ^ 2 - 80) (z : ℕ → ℝ) :
    ∑ i ∈ range 14, ∑ j ∈ range 14, z i * (Mk c i j).ev a * z j
      = (cc : ℝ) * ∑ i ∈ range 14, z i ^ 2
        - (sgnQ (c % 2) : ℝ) * ∑ i ∈ range 14, ∑ j ∈ range 14, z i * (Ad (c / 2) i j).ev a * z j
        + (lam : ℝ) * ∑ b ∈ range 5, (∑ i ∈ range 14, (Kd i b).ev a * z i) ^ 2 := by
  have hzz : ∀ i j, z i * (Mk c i j).ev a * z j
      = z i * (((if i = j then cc else 0 : ℚ)) : ℝ) * z j
        - (sgnQ (c % 2) : ℝ) * (z i * (Ad (c / 2) i j).ev a * z j)
        + (lam : ℝ) * ∑ b ∈ range 5, z i * ((Kd i b).ev a * (Kd j b).ev a) * z j := by
    intro i j
    simp only [Mk, pen, Kel.ev_add, Kel.ev_sub, Kel.ev_smul, Kel.ev_ofQ,
      Kel.ev_mul _ _ ha, Finset.sum_range_succ, Finset.sum_range_zero]
    push_cast; ring
  have hdiag : ∑ i ∈ range 14, ∑ j ∈ range 14, z i * (((if i = j then cc else 0 : ℚ)) : ℝ) * z j
      = (cc : ℝ) * ∑ i ∈ range 14, z i ^ 2 := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [Finset.sum_eq_single i]
    · simp; ring
    · intro j _ hji; simp [Ne.symm hji]
    · intro h; exact absurd hi h
  have hpen : ∑ i ∈ range 14, ∑ j ∈ range 14, ∑ b ∈ range 5, z i * ((Kd i b).ev a * (Kd j b).ev a) * z j
      = ∑ b ∈ range 5, (∑ i ∈ range 14, (Kd i b).ev a * z i) ^ 2 := by
    calc _ = ∑ i ∈ range 14, ∑ b ∈ range 5, ∑ j ∈ range 14,
            z i * ((Kd i b).ev a * (Kd j b).ev a) * z j :=
          Finset.sum_congr rfl fun i _ => Finset.sum_comm
      _ = ∑ b ∈ range 5, ∑ i ∈ range 14, ∑ j ∈ range 14,
            z i * ((Kd i b).ev a * (Kd j b).ev a) * z j := Finset.sum_comm
      _ = _ := Finset.sum_congr rfl fun b _ => qf_rank1 (fun i => (Kd i b).ev a) z 14
  simp only [hzz, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
  rw [hdiag, hpen]

/-! ## The real α and the statements -/


/-- The quadratic form `wᵀA_αw` (α-index 0 or 1). -/
noncomputable def Qf (al : ℕ) (z : ℕ → ℝ) : ℝ :=
  ∑ i ∈ range 14, ∑ j ∈ range 14, z i * (Ad al i j).ev alpha * z j

/-- **Operator-norm bound on W**: `|wᵀA_αw| ≤ c|w|²` for `w ⊥ {r₁, r₂, r₃, ŝ₁, ŝ₂}`. -/
theorem opnorm_W (al : ℕ) (hal : al < 2) (z : ℕ → ℝ)
    (hker : ∀ b ∈ range 5, ∑ i ∈ range 14, (Kd i b).ev alpha * z i = 0) :
    |Qf al z| ≤ (cc : ℝ) * ∑ i ∈ range 14, z i ^ 2 := by
  have hK : ∑ b ∈ range 5, (∑ i ∈ range 14, (Kd i b).ev alpha * z i) ^ 2 = 0 :=
    Finset.sum_eq_zero fun b hb => by rw [hker b hb]; ring
  have hp := M_psd (2 * al) (by omega) alpha_box.1 alpha_box.2 z
  have hm := M_psd (2 * al + 1) (by omega) alpha_box.1 alpha_box.2 z
  rw [block (2 * al) alpha_minpoly, hK] at hp
  rw [block (2 * al + 1) alpha_minpoly, hK] at hm
  have e1 : (2 * al) / 2 = al := by omega
  have e2 : (2 * al + 1) / 2 = al := by omega
  have e3 : (2 * al) % 2 = 0 := by omega
  have e4 : (2 * al + 1) % 2 = 1 := by omega
  rw [e1, e3] at hp; rw [e2, e4] at hm
  have s0 : ((sgnQ 0 : ℚ) : ℝ) = 1 := by simp [sgnQ]
  have s1 : ((sgnQ 1 : ℚ) : ℝ) = -1 := by simp [sgnQ]
  rw [s0] at hp; rw [s1] at hm
  unfold Qf
  rw [abs_le]; constructor <;> linarith

/-- **Coupling bound**: `|σ₁ wᵀA₁w + σ₂ wᵀA₂w| ≤ c(|σ₁| + |σ₂|)|w|²` on W. -/
theorem coupling_bound (σ₁ σ₂ : ℝ) (z : ℕ → ℝ)
    (hker : ∀ b ∈ range 5, ∑ i ∈ range 14, (Kd i b).ev alpha * z i = 0) :
    |σ₁ * Qf 0 z + σ₂ * Qf 1 z| ≤ (cc : ℝ) * (|σ₁| + |σ₂|) * ∑ i ∈ range 14, z i ^ 2 := by
  have h0 := opnorm_W 0 (by norm_num) z hker
  have h1 := opnorm_W 1 (by norm_num) z hker
  calc |σ₁ * Qf 0 z + σ₂ * Qf 1 z| ≤ |σ₁ * Qf 0 z| + |σ₂ * Qf 1 z| := abs_add_le _ _
    _ = |σ₁| * |Qf 0 z| + |σ₂| * |Qf 1 z| := by rw [abs_mul, abs_mul]
    _ ≤ |σ₁| * ((cc : ℝ) * ∑ i ∈ range 14, z i ^ 2) + |σ₂| * ((cc : ℝ) * ∑ i ∈ range 14, z i ^ 2) := by
        gcongr
    _ = _ := by ring

/-- **The bound in the variables of the scalar argument**: with `a = |s|`, `a² = (5/2)(σ₁²+σ₂²)`, and
`b² = |w|²`, `|3C(s,w,w)| ≤ G1x3 · a · b²`, where `G1x3 = 3γ₁`. -/
theorem coupling_bound_a (σ₁ σ₂ a : ℝ) (ha0 : 0 ≤ a) (ha : a ^ 2 = (5 / 2) * (σ₁ ^ 2 + σ₂ ^ 2)) (z : ℕ → ℝ)
    (hker : ∀ b ∈ range 5, ∑ i ∈ range 14, (Kd i b).ev alpha * z i = 0) :
    |σ₁ * Qf 0 z + σ₂ * Qf 1 z| ≤ (G1x3 : ℝ) * a * ∑ i ∈ range 14, z i ^ 2 := by
  have h := coupling_bound σ₁ σ₂ z hker
  have hb2 : 0 ≤ ∑ i ∈ range 14, z i ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
  -- (|σ₁| + |σ₂|)² ≤ 2(σ₁² + σ₂²) = (4/5)a², and G1x3² ≥ 4cc²/5, so cc(|σ₁|+|σ₂|) ≤ G1x3·a
  have hs : (|σ₁| + |σ₂|) ^ 2 ≤ (4 / 5) * a ^ 2 := by
    nlinarith [sq_nonneg (|σ₁| - |σ₂|), sq_abs σ₁, sq_abs σ₂, ha]
  have hG : (4 / 5 : ℝ) * (cc : ℝ) ^ 2 ≤ (G1x3 : ℝ) ^ 2 := by norm_num [cc, G1x3]
  have hcc : (0 : ℝ) ≤ cc := by norm_num [cc]
  have hG0 : (0 : ℝ) ≤ G1x3 := by norm_num [G1x3]
  have habs : 0 ≤ |σ₁| + |σ₂| := by positivity
  have key : (cc : ℝ) * (|σ₁| + |σ₂|) ≤ (G1x3 : ℝ) * a := by
    have hsq : ((cc : ℝ) * (|σ₁| + |σ₂|)) ^ 2 ≤ ((G1x3 : ℝ) * a) ^ 2 := by
      calc ((cc : ℝ) * (|σ₁| + |σ₂|)) ^ 2 = (cc : ℝ) ^ 2 * (|σ₁| + |σ₂|) ^ 2 := by ring
        _ ≤ (cc : ℝ) ^ 2 * ((4 / 5) * a ^ 2) := by gcongr
        _ = ((4 / 5) * (cc : ℝ) ^ 2) * a ^ 2 := by ring
        _ ≤ (G1x3 : ℝ) ^ 2 * a ^ 2 := by gcongr
        _ = _ := by ring
    nlinarith [hsq, mul_nonneg hcc habs, mul_nonneg hG0 ha0]
  calc _ ≤ (cc : ℝ) * (|σ₁| + |σ₂|) * ∑ i ∈ range 14, z i ^ 2 := h
    _ ≤ (G1x3 : ℝ) * a * ∑ i ∈ range 14, z i ^ 2 := mul_le_mul_of_nonneg_right key hb2

end LocalGamma1

